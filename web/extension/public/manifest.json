{
  "manifest_version": 3,
  "name": "ZeroStress: a sandboxed agent for suspicious links",
  "short_name": "ZeroStress",
  "version": "0.3.0",
  "description": "Right-click a suspicious link: an agent opens it in a disposable microVM at zerostress.space, tells you what it sees, and asks you before anything risky.",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open the ZeroStress agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; frame-src https://zerostress.space"
  },
  "key": "",
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
