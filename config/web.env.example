# config/web.env: settings of the zerostress-web service (spec 010). Copy this file to config/web.env and fill it in;
# `./zs install` does that once on a new host and never overwrites it. On the server: `./zs config web` edits it and
# restarts the service. config/web.env is git-ignored and holds the model key: never commit or paste it anywhere.
#
# Lines without "#" are set on purpose. Commented lines show the default the code uses when the line is absent.
# Paths default to places under the project root (/zerostress on the server, the checkout on a developer's machine).
# Every variable is described in docs/configuration.md.

# ---- the model: Vultr Serverless Inference (OpenAI-compatible) --------------------------------------------
INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# the key: the only secret of the project. Empty key = no model, the agent works by the rules alone.
INFERENCE_API_KEY=
# chosen by measurement (spec 008, 8); fallbacks: qwen3.8-flash-next, mimo-v2.6-pro
INFERENCE_MODEL=qwen3.8-27b
# 1 = the model also sees the page's screenshot (vision); empty = text only
# INFERENCE_VISION=
# off = no model whatever else is set
# AGENT_MODEL=
# default = let a reasoning model think (spends tokens); anything else = told not to
# AGENT_MODEL_THINKING=
# AGENT_MODEL_TIMEOUT_S=30
# AGENT_MODEL_MAX_TOKENS=2000
# AGENT_MODEL_RETRIES=2
# AGENT_MODEL_CONCURRENCY=8
# daily budget of the whole service; past it the agent works by the rules alone
# AGENT_DAILY_REQUESTS=2000
# AGENT_DAILY_TOKENS=4000000
# how many actions the agent may take in one deep check
# AGENT_MAX_STEPS=5

# ---- Cloudflare URL Scanner: a second opinion on pages the sandbox could not read (a bot wall) -----------
# An account-scoped API token with Account > URL Scanner > Edit ("Radar Read" is not enough), and that account's id
# (32 hex characters). Both empty = off. A scan on the free plan is PUBLIC at Cloudflare: never send a visitor's
# link without asking them. The token is a secret like the model key.
# CF_URLSCANNER_ACCOUNT_ID=
# CF_URLSCANNER_TOKEN=

# What others already know about an address (web/agent/reputation.ts): each key is optional, each is a secret.
# Google Safe Browsing API (v4 Lookup, non-commercial use), VirusTotal (free public API: 4 lookups a minute),
# Spamhaus Data Query Service (free for non-commercial use, DBL).
# SAFE_BROWSING_API_KEY=
# VIRUSTOTAL_API_KEY=
# SPAMHAUS_DQS_KEY=
# urlscan.io (its verdict on the latest scan of the domain anyone made there)
# URLSCAN_API_KEY=

# ---- the web service ---------------------------------------------------------------------------------------
# WEB_PORT=8080
# WEB_DATA_DIR=<root>/data/web/tasks
# the built client
# WEB_CLIENT_DIR=<root>/build/client
# SUP_SOCKET=<root>/run/supervisor.sock
# example links under the input, "label|url;label|url"
# WEB_DEMOS=A harmless page|https://example.com/;A file to approve|https://zerostress.space/demo/shared-file|deep
# WEB_PUBLIC_URL=https://zerostress.space
# DB-IP Lite tables; without them the report names no countries
# GEO_DIR=<root>/data/geo
# the top of the Tranco list (https://tranco-list.eu); without it the report says nothing about how widely visited a site is
# TRANCO_DIR=<root>/data/tranco
# off = the age of a domain is not looked up (RDAP)
# WEB_RDAP=

# ---- limits per visitor address, and for the whole service (spec 007, 5) ------------------------------------
# WEB_LIMIT_PER_HOUR=5
# WEB_LIMIT_PER_DAY=20
# WEB_LIMIT_ACTIVE=1
# WEB_LIMIT_STREAMS=4
# WEB_LIMIT_DAILY_CAP=300
# WEB_LIMIT_CHAT_PER_HOUR=20
# WEB_LIMIT_CHAT_PER_REPORT=12
