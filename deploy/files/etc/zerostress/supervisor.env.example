# /etc/zerostress/supervisor.env: environment of the zerostress-supervisor service (spec 010, 4.3). No secrets.
# Owner root:zerostress-sup, mode 0640. deploy/install.sh creates it from this file once and never overwrites it;
# edit with `sudoedit`, then `systemctl restart zerostress-supervisor`.
#
# Lines without "#" are set on purpose. Commented lines show the default the code uses when the line is absent
# (supervisor/config.go; out-of-range values are refused at start). Every variable is described in docs/config.md.

# ---- microVMs and the queue (spec 006) ----------------------------------------------------------------------
# microVMs at once (1..4); measured on this host: 2 (docs/specs/006-supervisor-api.md)
SUP_CONCURRENCY=2
# SUP_QUEUE_MAX=20
# SUP_QUEUE_WAIT_S=120
# SUP_BOOT_TIMEOUT_S=15
# SUP_HARD_TIMEOUT_S=90
# SUP_VCPU=2
# SUP_MEM_MIB=1024
# refuse new runs below this much free disk
# SUP_MIN_FREE_GB=20
# SUP_RESULT_TTL_H=24

# ---- live sessions of deep checks (spec 006, v2) -------------------------------------------------------------
# SUP_SESSION_SLOTS=1
# SUP_SESSION_IDLE_S=60
# SUP_SESSION_MAX_S=300
# SUP_SESSION_GRACE_S=30
# how long a risky command waits for a person
# SUP_APPROVAL_TTL_S=300
# SUP_COMMAND_MAX=190
# SUP_COMMAND_TIMEOUT_S=30
