[Unit]
Description=ZeroStress web layer (pages, API, agent)
After=network.target zerostress-supervisor.service
Wants=zerostress-supervisor.service

[Service]
Type=simple
User=zerostress-web
Group=zerostress-web
# the supervisor's socket belongs to this group
SupplementaryGroups=zerostress-ipc
UMask=0077
# Everything lives under /zerostress (spec 010): the code runs straight from the checkout, read-only for the service;
# it writes only its own data directory, and its output goes to /zerostress/logs/web.log.
EnvironmentFile=/zerostress/config/web.env
Environment=NODE_ENV=production
WorkingDirectory=/zerostress/web
ExecStart=/zerostress/runtime/node/bin/node --disable-warning=ExperimentalWarning server/main.ts
StandardOutput=append:/zerostress/logs/web.log
StandardError=inherit
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

# The service holds the key to the model, so it gets as little as it needs: the supervisor's socket, the internet
# for the model, and one directory to write (the supervisor's data stays closed to it).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/zerostress/data/web
MemoryMax=768M
TasksMax=200

[Install]
WantedBy=multi-user.target
