[Unit]
Description=ZeroStress supervisor (one disposable Firecracker microVM per job)
After=network.target firewalld.service
Wants=firewalld.service

[Service]
Type=simple
User=zerostress-sup
# the primary group owns the API socket, so the web layer (group zerostress-ipc) can connect
Group=zerostress-ipc
SupplementaryGroups=kvm
UMask=0077
EnvironmentFile=/zerostress/config/supervisor.env
WorkingDirectory=/zerostress/data/supervisor
ExecStart=/zerostress/bin/zerostress-supervisor
StandardOutput=append:/zerostress/logs/supervisor.log
StandardError=inherit
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
# SIGTERM goes to the supervisor only, so it can drain running jobs itself; whatever is left (Firecracker children)
# is killed when the stop timeout ends. The default (control-group) would kill every microVM at once.
KillMode=mixed
# The microVMs run in units of their own (zsvm), outside this one's control group: when the service stops, for good or
# before a restart, whatever VM is left is stopped now, with its network, instead of living to its 15-minute limit
# (review E). "+": as root, like the sudo rule that lets the service call zsvm.
ExecStopPost=+/zerostress/bin/zsvm recover

# Hardening verified under SELinux Enforcing (spec 006, section 4).
# NoNewPrivileges must stay off: the service calls "sudo zsnet up|down". AF_NETLINK is needed by zsnet (ip, nft).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ReadWritePaths=/zerostress/data/supervisor /zerostress/run

[Install]
WantedBy=multi-user.target
