[Unit]
Description=Caddy (TLS and reverse proxy for zerostress-web)
After=network-online.target zerostress-web.service
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
ExecStart=/zerostress/bin/caddy run --environ --config /zerostress/config/Caddyfile
ExecReload=/zerostress/bin/caddy reload --config /zerostress/config/Caddyfile --force
StandardOutput=append:/zerostress/logs/caddy.log
StandardError=inherit
TimeoutStopSec=10
Restart=on-failure
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# certificates and Caddy's own state
ReadWritePaths=/zerostress/data/caddy
Environment=XDG_DATA_HOME=/zerostress/data/caddy XDG_CONFIG_HOME=/zerostress/data/caddy/config

[Install]
WantedBy=multi-user.target
