# Every pinned version and checksum of the host and the guest image, in one place (spec 010, 4.4).
# Read by deploy/install.sh and guest/image/build.sh. Checksums come from the publishers (Node's SHASUMS256.txt,
# go.dev/dl, the GitHub release pages, the Firecracker CI bucket); nothing is downloaded without one.

# ---- host runtime --------------------------------------------------------------------------------------------
NODE_VERSION=24.22.2
NODE_SHA256=48cc0e21e048790e54c0cf5749c2725005313d652651c40b7a21feb9697aaf75
FC_VERSION=v1.17.0
FC_SHA256=06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558
CADDY_VERSION=2.11.9
CADDY_SHA512=0e85544340290a16ce4bfb76fe7d65e9de1bf3a6e67f5ccfff30b30d27ea4c73e078077b7bf3e58ae60b6b12e44327705287059c775bca5782e8ee85ea7edd75
# the Go toolchain builds the supervisor and the guest agent on the host (until releases are built in CI)
GO_VERSION=1.27.3
GO_SHA256=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40

# ---- guest image (spec 004) ----------------------------------------------------------------------------------
GUEST_CI_PREFIX=firecracker-ci/20261028-84df49062576-0/x86_64
GUEST_ROOTFS_NAME=ubuntu-24.04.squashfs
GUEST_ROOTFS_SHA256=568127fd53c728c1f275fbbcc0d61da065b435e455b89307e985b32b02dc56d9
GUEST_KERNEL_VERSION=6.18.56
GUEST_KERNEL_SHA256=a00c1f68304e83ae4e0b5afe88972ad23fda52ed1a40335611aa18faa95d1b10
# Node inside the guest is the same version as on the host (NODE_VERSION, NODE_SHA256)
