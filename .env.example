# Copy to .env on the host. Never commit .env; secrets live only on the host, never in the guest image.

# Vultr Serverless Inference (OpenAI-compatible)
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
INFERENCE_MODEL=

# Send the screenshot to the model as well (the model must read images): 1 | empty
INFERENCE_VISION=
# "off" switches the model off whatever else is set: the agent then works by the rules alone
AGENT_MODEL=
# Limits (defaults in parentheses)
# AGENT_MODEL_TIMEOUT_S=30  AGENT_MODEL_RETRIES=2  AGENT_MODEL_CONCURRENCY=8
# AGENT_DAILY_REQUESTS=2000  AGENT_DAILY_TOKENS=4000000  AGENT_MAX_STEPS=5
