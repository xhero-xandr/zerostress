[Unit]
Description=ZeroStress guest agent (vsock job receiver)
After=local-fs.target

[Service]
# screenshots and saved downloads of the collector go to tmpfs, owned by the job user (spec 005, 3.6)
ExecStartPre=/usr/bin/install -d -o pw -g pw -m 0700 /run/zerostress/artifacts
ExecStart=/usr/local/bin/zerostress-agent -port 5000 -user pw -timeout 60s -- /opt/node/bin/node /opt/collector/collect.mjs
NoNewPrivileges=yes
ProtectSystem=full
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
StandardOutput=journal+console
StandardError=journal+console
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
